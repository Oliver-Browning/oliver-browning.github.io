---
// LinkedIn isn't wired up yet — add the URL below once you have it, rather
// than shipping a guessed link. (Same idea as the "don't add anything you
// didn't put there" rule for nav: no placeholder link to nowhere.)
const links = [
  { label: 'GitHub', href: 'https://github.com/Oliver-Browning' },
  // { label: 'LinkedIn', href: 'https://www.linkedin.com/in/...' },
  { label: 'Email', href: 'mailto:oliverbrowning6@gmail.com' },
  { label: 'Skills', href: '/skills' },
  { label: 'About', href: '/about' },
];
---

<footer class="site-footer" data-pagefind-ignore>
  <ul>
    {
      links.map((link) => (
        <li>
          <a class="link" href={link.href}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .site-footer ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
  }
</style>
