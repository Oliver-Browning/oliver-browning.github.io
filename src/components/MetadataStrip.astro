---
// Renders a list of metadata items as discrete elements with CSS
// border-dividers between them — not a joined string — so an empty or
// omitted field can never leave a dangling separator. Pass only the items
// that should show; falsy/empty entries should be filtered out by the
// caller before this component ever sees them.
export interface MetaItem {
  label: string;
  pill?: boolean;
  statusInProgress?: boolean;
  href?: string;
}

interface Props {
  items: MetaItem[];
}

const { items } = Astro.props;
---

<ul class="meta">
  {
    items.map((item) => {
      if (!item.pill) return <li>{item.label}</li>;
      const pillClass = ['pill', item.statusInProgress && 'status-in-progress'];
      return (
        <li>
          {item.href ? (
            <a class:list={pillClass} href={item.href}>
              {item.label}
            </a>
          ) : (
            <span class:list={pillClass}>{item.label}</span>
          )}
        </li>
      );
    })
  }
</ul>
