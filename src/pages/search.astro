---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search — Oliver Browning" description="Search project write-ups.">
	<h1>Search</h1>

	<div class="search-box">
		<input type="search" id="search-input" placeholder="Search write-ups…" autocomplete="off" />
	</div>

	<p id="expansion-note" class="note mono" hidden></p>
	<p id="status-note" class="note" hidden></p>
	<ul id="results" class="results-list"></ul>
</Layout>

<style>
	h1 {
		font-size: var(--text-2xl);
		margin-bottom: 1.5rem;
	}

	.search-box input {
		width: 100%;
		font-family: var(--font-serif);
		font-size: var(--text-lg);
		background: none;
		border: none;
		border-bottom: 2px solid var(--border);
		color: var(--text);
		padding: 0.4rem 0;
	}

	.search-box input:focus {
		outline: none;
		border-bottom-color: var(--accent);
	}

	.note {
		margin-top: 1rem;
		color: var(--muted);
		font-size: var(--text-sm);
	}

	.note.mono {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	.results-list {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 2rem;
	}

	:global(.result) {
		border-top: 1px solid var(--border);
		padding-top: 1.25rem;
	}

	:global(.result h2) {
		font-size: var(--text-lg);
		margin: 0 0 0.4rem;
	}

	:global(.result h2 a) {
		text-decoration: none;
	}

	:global(.result h2 a:hover) {
		text-decoration: underline;
		text-decoration-color: var(--accent);
	}

	:global(.result .excerpt) {
		margin-top: 0.5rem;
		color: var(--muted);
	}

	:global(.result .excerpt mark) {
		background: none;
		color: var(--accent);
		font-weight: 600;
	}
</style>

<script>
	import { buildSynonymGraph, expandQuery } from '../utils/synonymGraph';

	interface PagefindResultData {
		url: string;
		excerpt: string;
		meta: Record<string, string>;
		filters: Record<string, string[]>;
	}

	interface PagefindResult {
		id: string;
		score: number;
		data: () => Promise<PagefindResultData>;
	}

	interface PagefindApi {
		search: (query: string) => Promise<{ results: PagefindResult[] }>;
		init?: () => Promise<void>;
	}

	const input = document.getElementById('search-input') as HTMLInputElement;
	const resultsEl = document.getElementById('results')!;
	const expansionNote = document.getElementById('expansion-note')!;
	const statusNote = document.getElementById('status-note')!;
	const graph = buildSynonymGraph();

	let pagefindLoaded = false;
	let pagefind: PagefindApi | null = null;

	async function loadPagefind(): Promise<PagefindApi | null> {
		if (pagefindLoaded) return pagefind;
		pagefindLoaded = true;
		try {
			// Generated by the `pagefind` CLI against the built site — only
			// exists after `pnpm build`, not under `astro dev`. See CLAUDE.md.
			// @ts-expect-error — this module only exists after the build step.
			pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
			await pagefind?.init?.();
		} catch {
			pagefind = null;
		}
		return pagefind;
	}

	function statusPill(status: string) {
		if (status === 'in-progress') {
			return '<span class="pill status-in-progress">in-progress</span>';
		}
		return status;
	}

	function renderResults(items: PagefindResultData[]) {
		if (items.length === 0) {
			statusNote.hidden = false;
			statusNote.textContent = 'No write-ups match that search.';
			resultsEl.innerHTML = '';
			return;
		}
		statusNote.hidden = true;
		resultsEl.innerHTML = items
			.map((item) => {
				const domains = (item.filters.Domain ?? [])
					.map((d) => `<span class="pill">${d}</span>`)
					.join('');
				return `
					<li class="result">
						<h2><a href="${item.url}">${item.meta.title ?? 'Untitled'}</a></h2>
						<ul class="meta">
							<li>${item.meta.date ?? ''}</li>
							<li>${statusPill(item.meta.status ?? '')}</li>
							${domains ? `<li>${domains}</li>` : ''}
						</ul>
						<p class="excerpt">${item.excerpt}</p>
					</li>
				`;
			})
			.join('');
	}

	let debounceTimer: ReturnType<typeof setTimeout>;

	async function runSearch(query: string) {
		if (!query.trim()) {
			resultsEl.innerHTML = '';
			expansionNote.hidden = true;
			statusNote.hidden = true;
			return;
		}

		const api = await loadPagefind();
		if (!api) {
			statusNote.hidden = false;
			statusNote.textContent =
				"Search isn't available in dev mode — run pnpm build && pnpm preview to test it.";
			resultsEl.innerHTML = '';
			return;
		}

		const expansion = expandQuery(query, graph);
		if (expansion.length > 0) {
			expansionNote.hidden = false;
			expansionNote.textContent = `also searching: ${expansion.join(', ')}`;
		} else {
			expansionNote.hidden = true;
		}

		// Pagefind's search() ANDs every word within one call, so a synonym
		// expansion has to run as its own separate search per term (OR
		// semantics across terms) rather than one call with everything
		// mashed together — otherwise "x band" plus a dozen expansion words
		// would require all of them to appear on the same page at once.
		// Expansion-term hits count for less than a direct match on what was
		// actually typed, so literal matches still rank first.
		const searchTerms = [
			{ text: query, weight: 1 },
			...expansion.map((term) => ({ text: term, weight: 0.5 })),
		];

		const merged = new Map<string, { score: number; result: PagefindResult }>();
		await Promise.all(
			searchTerms.map(async ({ text, weight }) => {
				const { results } = await api.search(text);
				for (const result of results) {
					const existing = merged.get(result.id);
					const contribution = result.score * weight;
					if (existing) existing.score += contribution;
					else merged.set(result.id, { score: contribution, result });
				}
			}),
		);

		const ranked = Array.from(merged.values()).sort((a, b) => b.score - a.score);
		const items = await Promise.all(ranked.map(({ result }) => result.data()));
		renderResults(items);
	}

	input.addEventListener('input', () => {
		clearTimeout(debounceTimer);
		const query = input.value;
		debounceTimer = setTimeout(() => runSearch(query), 150);

		const url = new URL(location.href);
		if (query) url.searchParams.set('q', query);
		else url.searchParams.delete('q');
		history.replaceState(null, '', url);
	});

	// Static build: there's no server to read the query string per-request,
	// so the initial value has to come from the browser's own URL at load
	// time rather than an Astro prop (which would be fixed at build time).
	const initialQuery = new URLSearchParams(location.search).get('q') ?? '';
	if (initialQuery) {
		input.value = initialQuery;
		runSearch(initialQuery);
	}
	input.focus();
</script>
